# System Environment Settings
PORT=8000
HOST=0.0.0.0

# Database Configuration (FastAPI Backend automatically falls back to SQLite if Postgres is unavailable)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/financial_analysis

# Redis Configuration (FastAPI Backend automatically falls back to In-Memory Pub/Sub if Redis is unavailable)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB Configuration (FastAPI Backend automatically falls back to local memory if Qdrant is unavailable)
QDRANT_URL=http://localhost:6333

# AI & LLM Integrations
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# External APIs
NEWS_API_KEY=your_news_api_key_here
